# SplitFare local/deployment environment example
#
# Copy the relevant values into the hosting provider environment.
# Do not put secrets in NEXT_PUBLIC_* variables.

# Frontend (Vercel / Next.js)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_APP_ENV=local

# Backend (Render / Fly.io / Railway)
APP_ENV=local
APP_VERSION=0.1.0
API_BASE_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
ENABLE_MOCK_SUPPLIER=true
LOG_LEVEL=INFO
RATE_LIMIT_REQUESTS_PER_MINUTE=120
MAX_SUPPLIER_QUERIES_PER_SEARCH=120
MAX_CONCURRENT_SUPPLIER_REQUESTS=8

# Optional infrastructure
DATABASE_URL=
REDIS_URL=

# Duffel supplier config - backend-only, never NEXT_PUBLIC_*
# disabled: no Duffel calls; sandbox: requires duffel_test_*; live: requires authorised live token
DUFFEL_MODE=disabled
DUFFEL_API_TOKEN=
DUFFEL_BASE_URL=https://api.duffel.com
DUFFEL_API_VERSION=v2
EXTERNAL_API_TIMEOUT_SECONDS=10
DUFFEL_MAX_RETRIES=1
DUFFEL_CACHE_TTL_SECONDS=600
# Enable only if your Duffel agreement permits caching.
DUFFEL_ALLOWS_CACHE=false
# Keep empty until Duffel returns an offer-bound, contract-authorised redirect domain.
DUFFEL_BOOKING_ALLOWED_DOMAINS=
