# Used by the browser. Keep any future supplier API keys on the backend only.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend-only supplier credentials. Never expose these through NEXT_PUBLIC_*.
DUFFEL_API_TOKEN=
DUFFEL_BASE_URL=https://api.duffel.com
DUFFEL_API_VERSION=v2
EXTERNAL_API_TIMEOUT_SECONDS=10

# Optional infrastructure.
DATABASE_URL=postgresql+psycopg://splitfare:splitfare@localhost:5432/splitfare
REDIS_URL=
